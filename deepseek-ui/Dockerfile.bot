# AI Trading Bot — standalone TypeScript process
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache libc6-compat openssl

COPY package.json package-lock.json ./
RUN npm ci --prefer-offline

COPY . .

# Generate Prisma client with Alpine-compatible binaries (linux-musl-openssl-3.0.x)
ENV PRISMA_ENGINES_MIRROR=https://binaries.prisma.sh
RUN npx prisma generate

EXPOSE 3003

CMD ["npx", "tsx", "scripts/trading-bot.ts"]
